      "id": 28069,
      "name": "Pylon",
      "slug": "pylon-2",
      "batch": "Winter 2023",
      "url": "https://www.ycombinator.com/companies/pylon-2",
      "changed_fields": [
        "long_description",
        "one_liner",
        "stage",
        "team_size"
      ],
      "changes": {
        "long_description": {
          "before": "Pylon is the modern alternative to Zendesk, Intercom, Freshdesk, and Salesforce Service Cloud. We help B2B companies track customer support issues across common B2B channels including shared Slack channels (Slack Connect), Microsoft Teams, email, in-app chat, ticket forms, Slack community, and more.\r\n\r\nHundreds of fast-growing YC companies of all sizes like Vellum, Hightouch, and Deel are customers.\r\n\r\nLearn more at usepylon.com",
          "after": "Pylon is the only agentic support platform, purpose-built for B2B companies. For leaders scaling AI-native support teams, Pylon lets humans and agents collaborate on customer work – investigating, resolving, and acting on every signal across every channel that matters.\r\n\r\nUnlike platforms built before the AI era, Pylon enriches every interaction with deep account-level context, automates the low impact customer work, and surfaces answers before your team even has to ask. The result: faster responses, happier customers, and a system that continuously improves itself.\r\n\r\nHundreds of fast-growing YC companies of all sizes like Retool, Hightouch, and Deel use Pylon to manage their customers.\r\n\r\nLearn more at usepylon.com"
        },
        "one_liner": {
          "before": "The only customer support platform built for B2B.",
          "after": "The Agentic Support Platform purpose-built for B2B."
        },
        "stage": {
          "before": "Growth",
          "after": "Early"
        },
        "team_size": {
          "before": 90,
          "after": 120
        }
      }
    },
