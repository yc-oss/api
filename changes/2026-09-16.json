      ],
      "changes": {
        "long_description": {
          "before": "Manufacturing procurement teams spend 70% of their day buried in supplier emails and spreadsheets. Mandel fixes that. We're an AI supply chain coordinator that reads every supplier email, extracts the data that matters - POs, quotes, delivery dates, pricing - and catches disruptions before they cost you. \r\n",
          "after": "Mandel runs the operational work across direct-materials sourcing and ordering - from RFQ through invoice - for manufacturers and distributors. It coordinates suppliers, checks orders and invoices against agreed terms, resolves discrepancies, recovers supplier credits, and keeps the ERP current.\r\n\r\nWorking across email, supplier portals, EDI, and ERP systems, Mandel investigates issues and carries out the next steps within your team’s approval rules."
        },
        "one_liner": {
          "before": "AI Supply Chain Coordinator",
          "after": "AI Coordination Layer for Supply Chain"
        },
        "team_size": {
          "before": 2,
          "after": 9
        }
      }
