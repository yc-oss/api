    {
      "id": 31335,
      "name": "Memoir",
      "slug": "memoir",
      "batch": "Spring 2026",
      "url": "https://www.ycombinator.com/companies/memoir",
      "changed_fields": [
        "industries",
        "long_description",
        "one_liner",
        "subindustry"
      ],
      "changes": {
        "industries": {
          "before": [
            "B2B",
            "Marketing"
          ],
          "after": [
            "B2B"
          ]
        },
        "long_description": {
          "before": "Memoir turns what your team ships into marketing material. It connects to GitHub, Linear, Slack, customer feedback, and product analytics to understand what changed, why it matters, who should hear about it, and how to tell the story.\r\n\r\nFrom there, Memoir creates multi-touchpoint marketing across social, blogs, changelogs, demo videos, customer updates, and launch content, all in your company’s voice. It also watches what is getting traction in your market, learns from your edits and campaign performance, and gets better every time you ship.\r\n\r\nIt is not a generic AI content tool. Memoir is a marketer with the soul of an engineer: it starts from the product source of truth and turns product velocity into market velocity.",
          "after": "Memoir is building a persistent and proactive AI teammate that helps an entire company keep up with its own progress. Think Instinct but for enterprise. We’re starting with product changes. When engineering ships something, Memoir understands who it affects and creates what each audience needs: a walkthrough for a customer, launch materials for a product marketer, or a technical explanation for another engineering team. It chooses the format and timing, then delivers the approved material in Slack. Nobody has to ask it to start.\r\n\r\nWe’re beginning with hands-on deployments, learning how each company works and where people depend on one another. That understanding will let Memoir expand beyond product releases to customer commitments, business decisions, and changes across departments. The idea grew from conversations with product marketers struggling to keep up with engineering, and the possibility of extending a proactive personal AI teammate to an entire business. \r\n\r\nOur ambition is a company where every important change sets the right communication in motion: the people affected receive something made for them, when they need it, without someone having to coordinate every handoff. As AI makes individual teams faster, Memoir helps that speed carry through the whole company."
        },
        "one_liner": {
          "before": "Marketing campaigns from everything your team ships",
          "after": "Everything your team ships, explained to everyone it affects."
        },
        "subindustry": {
          "before": "B2B -> Marketing",
          "after": "B2B"
        }
      }
    },
