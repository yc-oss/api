    {
      "id": 37071,
      "name": "Acyclic Labs",
      "slug": "acyclic",
      "batch": "Fall 2026",
      "url": "https://www.ycombinator.com/companies/acyclic",
      "changed_fields": [
        "long_description",
        "one_liner"
      ],
      "changes": {
        "long_description": {
          "before": "",
          "after": "Acyclic runs agent swarms. Hand it a task from the CLI, the dashboard, or a coding agent over MCP, and it splits the work across many agents, each in its own sandbox, then merges what they produce into one result. Long agentic workflows finish in a fraction of the wall-clock time. Bring your own model keys or run the sandboxes in your own cloud; the harness underneath is open source. Coding is the first workload, and research and data work run the same way. Founded by Ram Vinjamuri and Varun Latthe. YC F26, London."
        },
        "one_liner": {
          "before": "building infra for scaling agent swarms efficiently",
          "after": "Rapid agent swarms: make any agentic workflow exponentially faster"
        }
