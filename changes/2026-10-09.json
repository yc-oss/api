    {
      "id": 33672,
      "name": "Grep AI",
      "slug": "grep-ai",
      "batch": "Fall 2026",
      "url": "https://www.ycombinator.com/companies/grep-ai",
      "changed_fields": [
        "long_description",
        "one_liner",
        "tags"
      ],
      "changes": {
        "long_description": {
          "before": "Grep AI is the fastest way to create, optimize, and deploy agents for high-stakes, research-intensive knowledge work you can't afford to get wrong. Our agents are used by both prosumers and global enterprises such as Airwallex, IG, Worldpay, and Citizens Bank.",
          "after": "Grep AI is the fastest way to create, optimize, and deploy agents for tedious, complex operational work that slows down your business. Our self-improving agents learn from every run, making them smarter and cheaper as you scale. IG.com a global retail brokerage used our agents to review compliance alerts and now 80% of their customers onboad without manual intervention, doubling first trades and propelling them to a FTSE 100 company. \r\n\r\nCustomers including Airwallex, Worldpay, Citizens Bank, FV Bank and Shopmonkey have used our agents to automate over 250,000 of operational work across compliance, onboarding, underwriting, corporate due diligence, document verification, merchant categorization, market and competitive research, rev ops and much more.\r\n\r\nWe founded Grep AI after experiencing firsthand how manual workflows can prevent a business from growing when we ran the platform team at Brex. We're now on a mission to rid businesses of tedious, repetitive so their employees can focus on the most high leverage tasks that matter."
        },
        "one_liner": {
          "before": "AI agents that automate high-stakes knowledge work you can't afford…",
          "after": "Self-improving agents that automate tedious operational work"
        },
