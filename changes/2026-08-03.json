    {
      "id": 32583,
      "name": "Graphify Labs",
      "slug": "graphify-labs",
      "batch": "Summer 2026",
      "url": "https://www.ycombinator.com/companies/graphify-labs",
      "changed_fields": [
        "long_description"
      ],
      "changes": {
        "long_description": {
          "before": "Graphify builds queryable knowledge graphs from local codebases and documents, 96K GitHub stars, 3.8M downloads, used in production by engineers at Rootly, Geotab, and Tweddle Group.The enterprise layer on top, a self-learning brain that continuously syncs an organisation's knowledge, evolves its own graph over time without forgetting, and enables formal verification of code and architecture decisions. Runs fully on-premise. No data leaves the building.",
          "after": "Graphify builds queryable knowledge graphs from local codebases, docs, and Jira (100K+ GitHub stars, ~4.2M downloads, used in production by engineers at Rootly, Geotab, Tweddle Group, and Superagent). \r\n\r\nOn that graph, its enterprise layer reviews every pull request and formally verifies each code change, proving the new behavior matches the old or handing back the exact input that breaks it. The graph updates itself as the code changes and keeps context instead of forgetting it, so your whole team and their coding agents work from one shared, always-current graph of the codebase instead of a thousand private threads. \r\n\r\nRuns fully on-premise, so no data leaves the building."
        }
      }
    },
